#!/bin/sh /etc/rc.common

START=99
STOP=13
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/passwall-cloud-direct daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/sbin/passwall-cloud-direct cleanup >/dev/null 2>&1 || true
}

reload_service() {
    /usr/sbin/passwall-cloud-direct sync
}

service_triggers() {
    procd_add_reload_trigger passwall
}
